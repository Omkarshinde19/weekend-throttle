# Copy to .env (which git ignores) and fill in.
#
# The app itself needs NO API keys: Open-Meteo (weather), OpenFreeMap (map tiles) and
# OSRM (road geometry, already baked into backend/app/data/geometry.json) are free and keyless.

# Only needed if you want Claude / the Vercel CLI to deploy from this machine.
# Create one at https://vercel.com/account/tokens
VERCEL_TOKEN=

# Optional: point the frontend at a backend on another domain. Leave empty to use /api
# (same domain on Vercel, Vite proxy locally).
VITE_API_URL=
