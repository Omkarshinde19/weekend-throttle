[
  {"id": "C_RAIN_HEAVY", "salience": 100, "group": "weather", "when": {"any": [{"fact": "ctx.weather.condition", "op": "in", "value": ["heavy_rain", "thunderstorm"]}, {"fact": "ctx.weather.precip_mm", "op": "gte", "value": 7.5}]}, "then": {"set": {"derived.rain_level": "heavy"}}, "explain": "Heavy rain reported ({ctx.weather.precip_mm} mm/h)"},
  {"id": "C_RAIN_MODERATE", "salience": 90, "group": "weather", "when": {"all": [{"not": {"fact": "derived.rain_level", "op": "exists"}}, {"any": [{"fact": "ctx.weather.condition", "op": "eq", "value": "rain"}, {"fact": "ctx.weather.precip_mm", "op": "between", "value": [2.5, 7.5]}]}]}, "then": {"set": {"derived.rain_level": "moderate"}}, "explain": "Steady rain expected"},
  {"id": "C_RAIN_LIGHT", "salience": 80, "group": "weather", "when": {"all": [{"not": {"fact": "derived.rain_level", "op": "exists"}}, {"any": [{"fact": "ctx.weather.condition", "op": "eq", "value": "drizzle"}, {"fact": "ctx.weather.precip_mm", "op": "between", "value": [0.2, 2.5]}]}]}, "then": {"set": {"derived.rain_level": "light"}}, "explain": "Light drizzle expected"},
  {"id": "C_RAIN_NONE", "salience": 10, "group": "weather", "when": {"not": {"fact": "derived.rain_level", "op": "exists"}}, "then": {"set": {"derived.rain_level": "none"}}, "explain": "No rain expected"},
  {"id": "C_ROAD_WET", "salience": 70, "group": "weather", "when": {"fact": "derived.rain_level", "op": "in", "value": ["light", "moderate", "heavy"]}, "then": {"set": {"derived.road_wet": true}, "multiply": {"derived.break_factor": 0.85}}, "explain": "Rain means wet roads — shorter gaps between breaks"},
  {"id": "C_OFFROAD_UNSAFE", "salience": 60, "group": "safety", "when": {"all": [{"fact": "derived.road_wet", "op": "eq", "value": true}, {"fact": "derived.rain_level", "op": "in", "value": ["moderate", "heavy"]}]}, "then": {"set": {"derived.offroad_unsafe": true}}, "explain": "Wet road + steady rain ⇒ unpaved tracks become unsafe"},
  {"id": "C_LOW_VISIBILITY", "salience": 70, "group": "weather", "when": {"any": [{"fact": "ctx.weather.condition", "op": "eq", "value": "fog"}, {"fact": "ctx.weather.visibility_km", "op": "lt", "value": 1}]}, "then": {"set": {"derived.visibility": "low"}}, "explain": "Low visibility (fog / mist)"},
  {"id": "C_LANDSLIDE_HIGH", "salience": 55, "group": "safety", "when": {"all": [{"fact": "derived.season", "op": "eq", "value": "monsoon"}, {"fact": "derived.rain_level", "op": "eq", "value": "heavy"}]}, "then": {"set": {"derived.landslide_risk": "high"}}, "explain": "Monsoon + heavy rain ⇒ high landslide risk on ghats"},
  {"id": "C_LANDSLIDE_MEDIUM", "salience": 50, "group": "safety", "when": {"all": [{"not": {"fact": "derived.landslide_risk", "op": "exists"}}, {"fact": "derived.season", "op": "eq", "value": "monsoon"}]}, "then": {"set": {"derived.landslide_risk": "medium"}}, "explain": "Monsoon season ⇒ moderate landslide risk on ghats"},
  {"id": "C_LANDSLIDE_LOW", "salience": 5, "group": "safety", "when": {"not": {"fact": "derived.landslide_risk", "op": "exists"}}, "then": {"set": {"derived.landslide_risk": "low"}}, "explain": "Outside monsoon ⇒ low landslide risk"},
  {"id": "C_PHOTO_SUNSET", "salience": 65, "group": "intent", "when": {"all": [{"fact": "ctx.intent", "op": "eq", "value": "photography"}, {"fact": "derived.minutes_to_sunset", "op": "between", "value": [30, 330]}]}, "then": {"set": {"derived.photo_target": "sunset"}}, "explain": "Photography with sunset {derived.sunset} ahead ⇒ chase golden hour"},
  {"id": "C_PHOTO_SUNRISE", "salience": 65, "group": "intent", "when": {"all": [{"fact": "ctx.intent", "op": "eq", "value": "photography"}, {"not": {"fact": "derived.photo_target", "op": "exists"}}, {"fact": "derived.minutes_to_sunrise", "op": "between", "value": [20, 240]}]}, "then": {"set": {"derived.photo_target": "sunrise"}}, "explain": "Early start before sunrise {derived.sunrise} ⇒ chase the sunrise"},
  {"id": "C_PHOTO_SCENERY", "salience": 64, "group": "intent", "when": {"all": [{"fact": "ctx.intent", "op": "eq", "value": "photography"}, {"not": {"fact": "derived.photo_target", "op": "exists"}}]}, "then": {"set": {"derived.photo_target": "scenery"}}, "explain": "Golden hour not reachable from this start time ⇒ prioritise scenery"},
  {"id": "C_NIGHT_MODE", "salience": 60, "group": "safety", "when": {"all": [{"fact": "derived.departs_in_dark", "op": "eq", "value": true}, {"not": {"fact": "derived.photo_target", "op": "eq", "value": "sunrise"}}]}, "then": {"set": {"derived.night_mode": true}, "multiply": {"derived.break_factor": 0.9}}, "explain": "Departure is after dark ⇒ night-ride rules apply"},
  {"id": "C_PREDAWN", "salience": 60, "group": "safety", "when": {"all": [{"fact": "derived.departs_in_dark", "op": "eq", "value": true}, {"fact": "derived.photo_target", "op": "eq", "value": "sunrise"}]}, "then": {"set": {"derived.predawn": true}}, "explain": "Pre-dawn start for a sunrise shoot ⇒ allowed, but the first stretch is in the dark"},
  {"id": "C_SKILL_BEGINNER", "salience": 90, "group": "rider", "when": {"fact": "ctx.experience", "op": "eq", "value": "beginner"}, "then": {"set": {"derived.max_difficulty": 3}, "multiply": {"derived.break_factor": 0.85}}, "explain": "Beginner rider ⇒ max difficulty 3/5"},
  {"id": "C_SKILL_INTERMEDIATE", "salience": 90, "group": "rider", "when": {"fact": "ctx.experience", "op": "eq", "value": "intermediate"}, "then": {"set": {"derived.max_difficulty": 4}}, "explain": "Intermediate rider ⇒ max difficulty 4/5"},
  {"id": "C_SKILL_EXPERT", "salience": 90, "group": "rider", "when": {"fact": "ctx.experience", "op": "eq", "value": "expert"}, "then": {"set": {"derived.max_difficulty": 5}}, "explain": "Expert rider ⇒ every route is open"},
  {"id": "C_WET_SKILL_CAP", "salience": 45, "group": "safety", "when": {"all": [{"fact": "derived.rain_level", "op": "eq", "value": "heavy"}, {"fact": "ctx.experience", "op": "ne", "value": "expert"}]}, "then": {"multiply": {"derived.max_difficulty": 0.75}}, "explain": "Heavy rain lowers the difficulty ceiling for non-expert riders"},
  {"id": "C_PILLION", "salience": 50, "group": "rider", "when": {"fact": "ctx.pillion", "op": "eq", "value": true}, "then": {"set": {"derived.pillion_comfort": true}, "multiply": {"derived.break_factor": 0.85}}, "explain": "Riding with a pillion ⇒ comfort matters, more frequent breaks"},
  {"id": "C_HEAT", "salience": 50, "group": "weather", "when": {"fact": "ctx.weather.temp_c", "op": "gte", "value": 34}, "then": {"set": {"derived.heat_stress": true}, "multiply": {"derived.break_factor": 0.85}}, "explain": "Hot day ({ctx.weather.temp_c}°C) ⇒ prefer shade, hydrate often"},
  {"id": "C_COLD", "salience": 50, "group": "weather", "when": {"fact": "ctx.weather.temp_c", "op": "lte", "value": 15}, "then": {"set": {"derived.cold": true}}, "explain": "Cold ({ctx.weather.temp_c}°C) ⇒ layer up"},
  {"id": "C_CROWDS", "salience": 30, "group": "time", "when": {"all": [{"fact": "derived.is_weekend", "op": "eq", "value": true}, {"fact": "derived.hour", "op": "between", "value": [7, 19]}]}, "then": {"set": {"derived.crowd_expected": true}}, "explain": "Weekend daytime ⇒ tourist traffic at popular spots"}
]
